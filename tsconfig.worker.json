{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/worker/**/*.ts", "src/core/**/*.ts"],
  "exclude": ["src/core/**/*.test.ts"]
}
