{
  // Build and test tooling, the core unit tests that run on Node, and the Playwright tests.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "tools/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "svelte.config.js",
    "src/core/**/*.test.ts",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
