{
  "name": "fiets-vandaag",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b && svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cf-typegen": "wrangler types --strict-vars=false src/worker/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-istanbul": "~4.1",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "~4.1",
    "wrangler": "^4.151.0"
  }
}
